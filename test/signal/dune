; Approved white-box harness for unreachable overflow states only. Ordinary
; signal tests should link public eta_signal and must not grow new private
; module copy seams.
(library
 (name eta_signal_overflow_harness)
 (modules eta_signal_overflow_harness eta_signal_overflow_impl)
 (libraries eta eta_stream eta_signal_engine))

(rule
 (target eta_signal_overflow_impl.ml)
 (deps ../../lib/signal/kernel/eta_signal_kernel.ml)
 (action
  (copy %{deps} %{target})))


(library
 (name eta_signal_test_support)
 (wrapped false)
 (modules eta_signal_test_helpers eta_signal_test_interrupt_runtime)
 (libraries
  eta
  eta_observability
  eta_signal
  eta_signal_stream
  eta_stream
  eta_eio
  eta_test
  alcotest
  eio_main
  unix))

(test
 (name test_eta_signal)
 (modules test_eta_signal)
 (libraries
  eta
  eta_observability
  eta_signal
  eta_signal_test_support
  eta_stream
  eta_eio
  eta_test
  alcotest
  eio_main
  unix)
 (action
  (setenv EIO_BACKEND posix
   (run %{test}))))

(test
 (name test_eta_signal_overflow)
 (modules test_eta_signal_overflow)
 (libraries eta eta_signal eta_signal_overflow_harness eta_eio eta_test alcotest eio_main unix)
 (action
  (setenv EIO_BACKEND posix
   (run %{test}))))

(test
 (name test_eta_signal_public)
 (modules test_eta_signal_public)
 (libraries eta eta_signal eta_stream eta_eio eta_test alcotest eio_main unix)
 (action
  (setenv EIO_BACKEND posix
   (run %{test}))))

(rule
 (alias runtest)
 (deps
  (source_tree negative)
  (:eta_signal_cma ../../lib/signal/eta_signal.cma)
  (:eta_signal_stream_cma ../../lib/signal_stream/eta_signal_stream.cma))
 (action
  (run bash negative/run.sh %{eta_signal_cma} %{eta_signal_stream_cma})))
