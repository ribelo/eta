--- a/bench/runtime_observability/runtime_observability.ml
+++ b/bench/runtime_observability/runtime_observability.ml
@@ -40,6 +40,23 @@ let metric_chain n =
   in
   go n Effect.unit

+let batch_metrics =
+  List.init 4 @@ fun i ->
+  Effect.metric ~name:("bench.batch." ^ string_of_int i)
+    ~description:"bench" ~unit_:"1" ~attrs:[ ("phase", "bench") ]
+    ~kind:(Capabilities.Counter { monotonic = true })
+    (Capabilities.Number (Capabilities.Int 1))
+
+let metric_batch_chain ~lazy_ n =
+  let update =
+    if lazy_ then Effect.metric_updates_lazy (fun () -> batch_metrics)
+    else Effect.metric_updates batch_metrics
+  in
+  let rec go i acc =
+    if i = 0 then acc else go (i - 1) (Effect.bind (fun () -> update) acc)
+  in
+  go n Effect.unit
+
 let run ?tracer ?logger ?meter ?(auto_instrument = false) program =
   Eio_main.run @@ fun stdenv ->
   Eio.Switch.run @@ fun sw ->
